rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isModerator() {
      return isSignedIn()
        && userDoc().data.role in ['admin', 'moderator'];
    }

    function ownsConfession(confessionId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/confessionAuthors/$(confessionId)).data.authorUid == request.auth.uid;
    }

    function isValidProgram(value) {
      return value in [
        'analitica-datos',
        'animacion-digital',
        'ciberseguridad',
        'desarrollo-software',
        'simulaciones-videojuegos',
        'diseno-industrial',
        'energias-renovables',
        'informatica-forense',
        'inteligencia-artificial',
        'manufactura-automatizada',
        'manufactura-dispositivos-medicos',
        'mecatronica',
        'multimedia',
        'redes-informacion',
        'seguridad-informatica',
        'semiconductores-microelectronica',
        'sonido',
        'telecomunicaciones'
      ];
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'program', 'role', 'status', 'authProvider',
          'termsVersion', 'termsAcceptedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && isValidProgram(request.resource.data.program)
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active'
        && request.resource.data.authProvider in ['password', 'microsoft.com']
        && request.resource.data.termsVersion == '2026-09-23'
        && request.resource.data.termsAcceptedAt != null;

      allow read: if isOwner(uid);

      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.authProvider == resource.data.authProvider
        && request.resource.data.termsVersion == resource.data.termsVersion
        && request.resource.data.termsAcceptedAt == resource.data.termsAcceptedAt
        && (!request.resource.data.keys().hasAny(['program']) || isValidProgram(request.resource.data.program))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'program', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /confessions/{confessionId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'recipientText', 'text', 'visibility', 'isAnonymous',
          'authorDisplayName', 'authorProgram', 'tags', 'status',
          'likeCount', 'commentCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.recipientText is string
        && request.resource.data.recipientText.size() <= 80
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.isAnonymous is bool
        && request.resource.data.authorProgram is string
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 6
        && request.resource.data.status == 'active'
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && (
          (
            request.resource.data.isAnonymous == true
            && request.resource.data.authorDisplayName == ''
            && request.resource.data.authorProgram == ''
          )
          || (
            request.resource.data.isAnonymous == false
            && request.resource.data.authorDisplayName == userDoc().data.displayName
            && request.resource.data.authorProgram == userDoc().data.program
            && isValidProgram(request.resource.data.authorProgram)
          )
        )
        && getAfter(/databases/$(database)/documents/confessionAuthors/$(confessionId)).data.authorUid == request.auth.uid;

      allow read: if (
          resource.data.visibility == 'public'
          && resource.data.status == 'active'
        )
        || ownsConfession(confessionId)
        || isModerator();

      allow update: if (
          ownsConfession(confessionId)
          && resource.data.status == 'active'
          && request.resource.data.status == 'deleted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt'
          ])
        )
        || isModerator();

      allow delete: if false;
    }

    match /confessionAuthors/{confessionId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['authorUid', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/confessions/$(confessionId)).data.status == 'active';

      allow read: if (
          isSignedIn()
          && resource.data.authorUid == request.auth.uid
        )
        || isModerator();

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
