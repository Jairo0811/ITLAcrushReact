# Copia este archivo como .env.production antes de compilar para producción.
# Las claves web de Firebase identifican el proyecto, pero no sustituyen las reglas
# de seguridad ni deben confundirse con secretos administrativos.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=itla-crush-cb9bd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=itla-crush-cb9bd
VITE_FIREBASE_STORAGE_BUCKET=itla-crush-cb9bd.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Restringe el proveedor Microsoft al tenant institucional del ITLA.
VITE_MICROSOFT_TENANT=itla.edu.do
